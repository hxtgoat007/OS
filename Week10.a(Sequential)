#include<stdio.h>
int main() {
    int n,b[10],sb[10],i,j,x;
    printf("Enter no of files: ");
    scanf("%d",&n);
    for(i=0;i<n;i++){
        printf("Blocks of file %d: ",i+1);
        scanf("%d",&b[i]);
        printf("Start block of file %d: ",i+1);
        scanf("%d",&sb[i]);
    }
    printf("\nFile\tStart\tLength\n");
    for(i=0;i<n;i++)
        printf("%d\t%d\t%d\n",i+1,sb[i],b[i]);

    printf("Enter file name: ");
    scanf("%d",&x);
    printf("File name is: %d",x);
    printf("\nLength is: %d",b[x-1]);
    printf("\nBlocks: ");
    for(i=0;i<b[x-1];i++)
        printf("%d ",sb[x-1]+i);
}

