#include <stdio.h>
#include <unistd.h>
int global = 10;   // global variable
int main() {
    int local = 20;   // local variable
    pid_t pid;
    printf("Before fork\n");
    printf("pid = %d, global = %d, local = %d\n", getpid(), global, local);
    pid = fork();   // create child process
    if(pid == 0) {
        // Child process
        global++;
        local++;
        printf("After fork (Child)\n");
        printf("pid = %d, global = %d, local = %d\n", getpid(), global, local);
    } else {
        // Parent process
        global++;
        printf("After fork (Parent)\n");
        printf("pid = %d, global = %d, local = %d\n", getpid(), global, local);
    }
    return 0;
}

