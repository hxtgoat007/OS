#include <stdio.h>
int main() {
    int base, limit, offset;
    printf("Enter base address: ");
    scanf("%d", &base);
    printf("Enter limit: ");
    scanf("%d", &limit);
    printf("Enter logical address (offset): ");
    scanf("%d", &offset);
    if(offset < limit) {
        int physical = base + offset;
        printf("Mapped physical address is = %d\n", physical);
    } else {
        printf("Error: Address exceeds limit\n");
    }
    return 0;
}

