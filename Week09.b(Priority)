#include <stdio.h>
int main() {
    int n,i,j;
    int bt[10],pr[10],pid[10],wt[10],tat[10];
    printf("Enter no of processes: ");
    scanf("%d",&n);
    for(i=0;i<n;i++){
        pid[i]=i+1;
        printf("Enter BT and Priority: ");
        scanf("%d%d",&bt[i],&pr[i]);
    }
    // sort by priority (small number = high priority)
    for(i=0;i<n;i++){
        for(j=i+1;j<n;j++){
            if(pr[i]>pr[j]){
                int t=pr[i]; pr[i]=pr[j]; pr[j]=t;
                t=bt[i]; bt[i]=bt[j]; bt[j]=t;
                t=pid[i]; pid[i]=pid[j]; pid[j]=t;
            }
        }
    }
    wt[0]=0;
    for(i=1;i<n;i++)
        wt[i]=wt[i-1]+bt[i-1];
    for(i=0;i<n;i++)
        tat[i]=wt[i]+bt[i];
    printf("\nPID\tP\tBT\tWT\tTAT\n");
    for(i=0;i<n;i++)
        printf("%d\t%d\t%d\t%d\t%d\n",pid[i],pr[i],bt[i],wt[i],tat[i]);
    return 0;
}

