#include <stdio.h>

int main() {
    int frames[10], pages[20], n, f, i, j, k=0, fault=0, found;
    printf("Enter no of frames: ");
    scanf("%d",&f);
    printf("Enter no of reference string: ");
    scanf("%d",&n);
    printf("Enter reference string: ");
    for(i=0;i<n;i++) 
        scanf("%d",&pages[i]);
    for(i=0;i<f;i++) 
        frames[i]=-1;
    for(i=0;i<n;i++) {
        found=0;
        for(j=0;j<f;j++)
            if(frames[j]==pages[i]) found=1;
        if(!found) {
            frames[k]=pages[i];
            k=(k+1)%f;
            fault++;
        }
    }
    printf("Page fault is %d", fault);
}

