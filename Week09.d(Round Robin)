#include <stdio.h>
int main() {
    int n, i, time=0, remain;
    int bt[10], rem[10], wt[10]={0}, tat[10];
    int tq;
    float awt, atat;
    printf("Enter no of processes: ");
    scanf("%d",&n);
    printf("Enter time quantum: ");
    scanf("%d",&tq);
    for(i=0;i<n;i++){
        printf("Enter BT: ");
        scanf("%d",&bt[i]);
        rem[i]=bt[i];
    }
    remain=n;
    while(remain>0){
        for(i=0;i<n;i++){
            if(rem[i]>0){
                if(rem[i]>tq){
                    time+=tq;
                    rem[i]-=tq;
                } else {
                    time+=rem[i];
                    wt[i]=time-bt[i];
                    rem[i]=0;
                    remain--;
                }
            }
        }
    }
    for(i=0;i<n;i++)
        tat[i]=bt[i]+wt[i];
    printf("\nPID\tBT\tWT\tTAT\n");
    for(i=0;i<n;i++)
        printf("%d\t%d\t%d\t%d\n",i+1,bt[i],wt[i],tat[i]);
    awt = wt / n;
    atat = tat / n;
    printf("\nAvg WT: %f\nAvg TAT: %f", awt, atat);
    return 0;
}

