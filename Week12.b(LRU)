#include <stdio.h>
int main() {
    int frames[10], pages[50], time[10];
    int n, f, i, j, k, flag, faults = 0, count = 0, min, pos;
    printf("Enter no of frames: ");
    scanf("%d", &f);
    printf("Enter no of reference string: ");
    scanf("%d", &n);
    printf("Enter reference string:\n");
    for(i = 0; i < n; i++) {
        scanf("%d", &pages[i]);
    }
    for(i = 0; i < f; i++) {
        frames[i] = -1;
        time[i] = 0;
    }
    printf("\n");
    for(i = 0; i < n; i++) {
        flag = 0;
        for(j = 0; j < f; j++) {
            if(frames[j] == pages[i]) {
                count++;
                time[j] = count;
                flag = 1;
                break;
            }
        }
        if(flag == 0) {
            faults++;
            for(j = 0; j < f; j++) {
                if(frames[j] == -1) {
                    count++;
                    frames[j] = pages[i];
                    time[j] = count;
                    flag = 1;
                    break;
                }
            }
        }
        if(flag == 0) {
            min = time[0];
            pos = 0;
            for(j = 1; j < f; j++) {
                if(time[j] < min) {
                    min = time[j];
                    pos = j;
                }
            }
            count++;
            frames[pos] = pages[i];
            time[pos] = count;
        }
        printf("Reference no %d -> ", pages[i]);
        for(j = 0; j < f; j++) {
            if(frames[j] != -1)
                printf("%d ", frames[j]);
        }
        printf("\n");
    }
    printf("\nPage fault is %d\n", faults);
    return 0;
}

