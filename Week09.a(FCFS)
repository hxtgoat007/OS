#include <stdio.h>
int main() {
    int n, i;
    int bt[10], wt[10], tat[10];
    float awt, atat;
    printf("Enter no of processes: ");
    scanf("%d", &n);
    printf("Enter burst times: ");
    for(i=0;i<n;i++) scanf("%d",&bt[i]);
    wt[0]=0;
    for(i=1;i<n;i++)
        wt[i]=wt[i-1]+bt[i-1];
    for(i=0;i<n;i++)
        tat[i]=wt[i]+bt[i];
    printf("\nPID\tBT\tWT\tTAT\n");
    for(i=0;i<n;i++)
        printf("%d\t%d\t%d\t%d\n",i+1,bt[i],wt[i],tat[i]);
    awt = wt / n;
    atat = tat / n;
    printf("\nAvg WT: %f\nAvg TAT: %f", awt, atat);
    return 0;
}

